[server]
host = 127.0.0.1
port = 8765

[upstream]
base_url = http://llm.example.com/v1
timeout_seconds = 600
max_request_body_bytes = 134217728

[rate_limit]
min_interval_seconds = 10
max_retries = 5
backoff_base_seconds = 5
backoff_max_seconds = 60
backoff_jitter_seconds = 1

[forward_proxy]
# Leave these empty when the upstream API is directly reachable.
http = http://proxy.example.com:8080

# Common launcher policy only: no API keys or personal key-file paths here.
[launcher]
# Executable on PATH or an absolute path to Codex.
codex_binary = codex
# Existing custom provider in ~/.codex/config.toml.
provider = corp

[lifecycle]
# Stop after no sessions AND no active requests for this many seconds.
# Managed mode only; checked approximately every two seconds.
idle_timeout_seconds = 1800
